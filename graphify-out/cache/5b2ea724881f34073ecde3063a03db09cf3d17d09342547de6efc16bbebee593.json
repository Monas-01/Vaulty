{"__graphifyTsExtractorVersion":63,"nodes":[{"id":"route","label":"route.ts","file_type":"code","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L1","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L1"}]},{"id":"route_parsepricenumber","label":"parsePriceNumber()","file_type":"code","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L8-L16","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L8"}],"snippet":"function parsePriceNumber(val: any): number | null {\n  if (typeof val === \"number\" && !isNaN(val)) return val;\n  if (typeof val === \"string\") {\n    const cleaned = val.replace(/[^0-9.]/g, \"\");\n    const parsed = parseFloat(cleaned);\n    if (!isNaN(parsed) && parsed >= 0) return parsed;\n  }\n  return null;\n}"},{"id":"route_parseformatteddate","label":"parseFormattedDate()","file_type":"code","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L18-L27","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L18"}],"snippet":"function parseFormattedDate(val: any): string | null {\n  if (typeof val !== \"string\" || !val.trim()) return null;\n  const str = val.trim();\n  if (/^\\d{4}-\\d{2}-\\d{2}$/.test(str)) return str;\n  const d = new Date(str);\n  if (!isNaN(d.getTime())) {\n    return d.toISOString().split(\"T\")[0];\n  }\n  return null;\n}"},{"id":"route_post","label":"POST()","file_type":"code","source_file":"D:/VS Code/Vaulty/Code/src/app/api/ai/extract/route.ts","source_location":"L29-L294","layer":"base","provenance":[{"capability_id":"builti