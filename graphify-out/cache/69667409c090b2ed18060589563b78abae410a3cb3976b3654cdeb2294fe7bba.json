antyMonths: initialValues?.warrantyMonths ?? 12,\n      store: initialValues?.store || \"\",\n      notes: initialValues?.notes || \"\",\n      purchasePrice: initialValues?.purchasePrice ?? undefined,\n      receiptUrl: initialValues?.receiptUrl || \"\",\n    },\n  });\n\n  const onSubmit = async (values: ProductFormValues) => {\n    setIsSubmitting(true);","node_kind":"function","framework":"nextjs","framework_role":"next_client_component","runtime_boundary":"client"},{"id":"product_form_productform_onsubmit","label":"onSubmit()","file_type":"code","source_file":"D:/VS Code/Vaulty/Code/src/components/products/product-form.tsx","source_location":"L52-L73","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/VS Code/Vaulty/Code/src/components/products/product-form.tsx","source_location":"L52"}],"snippet":"onSubmit = async (values: ProductFormValues) => {\n    setIsSubmitting(true);\n    try {\n      if (isEdit && initialValues?.id) {\n        await updateProductAction(initialValues.id, values);\n        toast.success(\"Product updated successfully\");\n        router.push(`/dashboard/products/${initialValues.id}`);\n      } else {\n        const result = await createProductAction(values);\n        toast.success(\"Product created successfully\");\n        router.push(`/dashboard/products/${result.id}`);\n      }\n      router.refresh();\n    } catch (error) {\n      console.error(error);\n      toast.error(\n        error instanceof Error ? error.message : \"Failed to save product\",\n      );\n    } finally {\n      setIsSubmitting(false);\n    }\n  }"}],"edges":[{"source":"product_form","target":"zod","relation":"imports_from","confidence":"EXTRACTED","source_file":"D:/VS Code/Vaulty/Code/src/components/products/product-form.tsx","source_location":"L3","layer":"base","provenance":[{"capability_id":"builtin:extract:typescript","stage":"extract","source_file":"D:/VS Code/Vaulty/Code/src/components/products/pro