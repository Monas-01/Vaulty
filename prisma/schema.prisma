// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String         @id @default(cuid())
  userId          String
  name            String
  brand           String?
  category        String?
  purchaseDate    DateTime
  warrantyMonths  Int
  store           String?
  notes           String?
  purchasePrice   Float?
  receiptUrl      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  notifications   Notification[]

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  productId String
  title     String
  message   String
  type      String   // WARRANTY_EXPIRING_30 | WARRANTY_EXPIRING_7 | WARRANTY_EXPIRING_1 | WARRANTY_EXPIRED
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model UserPreferences {
  id           String   @id @default(cuid())
  userId       String   @unique
  remind30Days Boolean  @default(true)
  remind7Days  Boolean  @default(true)
  remind1Day   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExtractionAttempt {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}


